#!/usr/bin/env bash
###############################################################################
# Words With Friends helper - find words in Scrabble / Words With Friends
#
# Revised for correctness, performance, and maintainability.
#
# $Source: /Users/dan/.scripts/scrab $
# $Revision: 1.29 $
###############################################################################

set -o noglob

me="$(basename "$0")"
version="1.29"
args="$*"

usage() {
    echo "${me} version ${version}"
    echo

    if [[ "${1:-}" == "version" ]]; then
        exit 0
    fi

    echo "${me} lists combinations of words from given letters."
    echo
    echo "Usage: ${me} rack [options]"
    echo
    echo "rack is the letters given and should be the first argument unless explicitly"
    echo "set as an option."
    echo
    echo "Options"
    echo "  -r letters   Specify a rack explicitly as an option."
    echo "  -p prefix    Show words starting with board \"prefix\"."
    echo "  -P prefix    Show words starting with \"prefix\"."
    echo "  -s suffix    Show words ending with board \"suffix\"."
    echo "  -S suffix    Show words ending with \"suffix\"."
    echo "  -e letters   Either prefix OR suffix (short for -p letters -s letters)."
    echo "  -E letters   Either prefix OR suffix (short for -P letters -S letters)."
    echo "  -a           Both specified prefix AND specified suffix."
    echo "  -u word      Use a board word in the middle. Equivalent to -m '.*word.*'."
    echo "  -U word      As above, using only letters you have."
    echo "  -x letters   Include board \"letters\"."
    echo "  -R letters   Remove board \"letters\" from the rack."
    echo "  -m 'regex'   Find words matching regex; literal letters are board letters."
    echo "  -M 'regex'   Find words matching regex using only letters you have."
    echo "  -q letters   Require these characters; add them as board letters."
    echo "  -Q letters   Require these characters from your rack."
    echo "  -l m         Show words at least m letters long."
    echo "  -L n         Show words at most n letters long."
    echo "  -w n         Show words exactly n letters wide."
    echo "  -D dict      Add specified dictionary (may be used multiple times)."
    echo "               Default: \$DEFAULT_DICT or /usr/share/dict/words"
    echo "  -4 letter    Repeat rack four times and require letter (NYT Bee helper)."
    echo "  -b           Blank letter: iterate over [a-z]."
    echo "  -n           No summary stats; just words."
    echo "  -v           Verbose."
    echo "  -d           Debug."
    echo "  --use        Iterate using all following words until next option."
    echo "  --pre        Iterate using all following prefixes until next option."
    echo "  --suf        Iterate using all following suffixes until next option."
    echo "  --version    Show version."
    echo "  --help       Show this message."
    echo "  --examples   Show examples."
    echo

    [[ "${1:-}" == "help" ]] && exit 0
    [[ "${1:-}" != "examples" ]] && {
        [[ -n "${1:-}" ]] && printf '%s\n\n' "$1"
        exit 1
    }

    echo "All arguments are case insensitive."
    echo
    echo "Examples:"
    echo "${me} cat -pa"
    echo "    yields 'aa at act acta'"
    echo
    echo "${me} cat -ur"
    echo "    yields 'ar arc art car rat tar cart'"
    echo
    echo "${me} cat -ps -sb"
    echo "    yields 'ab cab sac sat tab scat'"
    echo
    echo "${me} cat -ps -sb -a"
    echo "    yields 'sab scab stab'"
    echo
    echo "${me} cat -ps -sb -ur"
    echo "    yields 'arb carb crab scar star scart'"
    echo
    echo "${me} cat -ps -sb -m '.*r.'"
    echo "    yields 'arb carb scart'"
    echo
    echo "${me} cat -M 'a.*'"
    echo "    yields 'at act'"
    echo
    echo "${me} qist -xu -qq"
    echo "    yields 'qi qis suq quit quits'"
    exit 0
}

enter() {
    [[ -z "${o_debug:-}" ]] && return 0
    local fn=$1 ln=$2
    shift 2
    printf 'Line %3s, %s' "$ln" "$fn"
    (($#)) && printf '( %s )' "$*"
    printf '\n'
}

grr() {
    enter "${FUNCNAME[0]}" "$LINENO" "$@"
    [[ -z "${o_growl:-}" ]] && return 0
    growl "$@"
}

vecho()   { [[ -n "${o_verbose:-}" ]] && echo "$*"; }
vechonr() { [[ -n "${o_verbose:-}" ]] && printf '%s' "$*"; }
vgrr()    { [[ -n "${o_verbose:-}" ]] && grr "$*"; }
decho()   { [[ -n "${o_debug:-}" ]] && echo "$*"; }
don()     { [[ -n "${o_debug:-}" ]] && set -x; }
doff()    { [[ -n "${o_debug:-}" ]] && set +x; }

cleanup() {
    rm -f "${tmp1:-}" "${tmp2:-}" "${tempdict:-}" "${combined:-}" "${lock:-}"
}

initFiles() {
    tmp1=$(mktemp -t "${me}.XXXXXX")
    tmp2=$(mktemp -t "${me}.XXXXXX")
    tempdict=$(mktemp -t "${me}.XXXXXX")
    combined=$(mktemp -t "${me}.XXXXXX")
    lock="/var/tmp/${me}.lock"
    trap cleanup EXIT INT TERM HUP
}

remove_letters_from_rack() {
    local rack=$1 remove=$2 ch
    while [[ -n "$remove" ]]; do
        ch=${remove:0:1}
        remove=${remove:1}
        rack=${rack/"$ch"/}
    done
    printf '%s' "$rack"
}

filterWords() {
    # Candidate words arrive in tmp2.
    # Strip board prefix/suffix as appropriate, then verify exact rack inventory
    # in one awk process instead of spawning sed once per word.
    local mode=$1

    awk \
        -v rack="$o_rack" \
        -v mode="$mode" \
        -v prefix="${o_prefix:-}" \
        -v suffix="${o_suffix:-}" '
        function inventory(s, a,    i,c) {
            delete a
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                a[c]++
            }
        }
        BEGIN {
            inventory(rack, base)
        }
        {
            orig = $0
            word = $0

            if (mode == "and") {
                word = substr(word, length(prefix) + 1)
                if (length(suffix) > 0)
                    word = substr(word, 1, length(word) - length(suffix))
            } else if (mode == "prefix") {
                word = substr(word, length(prefix) + 1)
            } else if (mode == "suffix") {
                word = substr(word, 1, length(word) - length(suffix))
            }

            delete have
            for (c in base)
                have[c] = base[c]

            ok = 1
            for (i = 1; i <= length(word); i++) {
                c = substr(word, i, 1)
                if (--have[c] < 0) {
                    ok = 0
                    break
                }
            }

            if (ok)
                print orig
        }
    ' "$tmp2" >> "$tmp1"
}

require_letters() {
    local infile=$1 outfile=$2 req=$3
    awk -v req="$req" '
        function inventory(s, a,    i,c) {
            delete a
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                a[c]++
            }
        }
        BEGIN { inventory(req, need) }
        {
            inventory($0, have)
            ok = 1
            for (c in need) {
                if (have[c] < need[c]) {
                    ok = 0
                    break
                }
            }
            if (ok) print
        }
    ' "$infile" > "$outfile"
}

showResults() {
    [[ ! -s "$combined" ]] && return 0

    vecho "Sorting $(wc -l < "$combined") words"

    awk '{ print length($0), $0 }' "$combined" \
        | sort -k1,1n -k2,2 \
        | cut -d' ' -f2- \
        | awk '!seen[$0]++' > "$tmp2"
    mv "$tmp2" "$combined"

    if [[ -n "${o_nosum:-}" ]]; then
        cat "$combined"
    else
        while IFS= read -r w; do
            if [[ "$w" =~ [kvjxqz] ]]; then
                printf '%s *\n' "$w"
            else
                printf '%s\n' "$w"
            fi
        done < "$combined"
    fi
}

checkOpts() {
    local opt line
    local minlength=${o_minlen:-1}
    local maxlength=${o_maxlen:-15}

    [[ -n "${o_no_rack:-}" ]] && usage "No rack specified."

    command -v growl >/dev/null 2>&1 && o_growl=true
    [[ -n "${o_debug:-}" ]] && o_verbose=true

    if [[ -n "${o_verbose:-}" ]]; then
        echo "Specified options:"
        for opt in o_prefix o_suffix o_either o_and o_minlen o_maxlen o_pat \
                   o_req o_dict o_debug o_verbose o_double o_nosum o_growl \
                   o_use o_remove; do
            [[ -n "${!opt:-}" ]] && printf '    %s: "%s"\n' "$opt" "${!opt}"
        done
        echo "Min is ${minlength}, max is ${maxlength}"
    fi

    for opt in o_rack o_prefix o_suffix o_either o_req o_remove; do
        if [[ -n "${!opt:-}" && "${!opt}" =~ [^[:alpha:]] ]]; then
            echo "Illegal letters specified for ${opt#o_}: ${!opt}"
            exit 2
        fi
    done

    if [[ -n "${o_remove:-}" ]]; then
        o_rack=$(remove_letters_from_rack "$o_rack" "$o_remove")
    fi

    if [[ -n "${o_and:-}" && ( -z "${o_prefix:-}" || -z "${o_suffix:-}" ) ]]; then
        echo "Both a prefix and a suffix are required with -a."
        exit 2
    elif [[ -n "${o_either:-}" ]]; then
        if [[ -n "${o_prefix:-}" || -n "${o_suffix:-}" ]]; then
            echo "Cannot use \"either\" option in combination with a prefix or suffix"
            exit 2
        fi
        o_prefix=$o_either
        o_suffix=$o_either
        o_either=true
    fi

    if [[ "$minlength" =~ [^0-9] || "$maxlength" =~ [^0-9] ]]; then
        echo "Illegal number for length: {${minlength},${maxlength}}"
        exit 2
    elif (( minlength > maxlength )); then
        echo "Min length ${minlength} must be less than or equal to ${maxlength}"
        exit 2
    fi

    o_len="\\{${minlength},${maxlength}\\}"

    [[ -z "${o_dict:-}" ]] && o_dict="${DEFAULT_DICT:-/usr/share/dict/words}"

    local valid=()
    IFS='|' read -r -a requested_dicts <<< "$o_dict"
    for line in "${requested_dicts[@]}"; do
        if [[ ! -r "$line" ]]; then
            echo "Dictionary ${line} does not exist or is not readable. Check path." >&2
        else
            valid+=("$line")
        fi
    done

    ((${#valid[@]} == 0)) && {
        echo "No readable dictionaries available." >&2
        exit 2
    }

    dicts=("${valid[@]}")
}

oneDict() {
    enter "${FUNCNAME[0]}" "$LINENO" "$@"

    : > "$tmp1"

    vecho "Processing dictionary file ${dict}..."

    if [[ -n "${o_pat:-}" ]]; then
        grep -Eix "^${o_pat}$" "$dict" > "$tempdict"
    else
        cp "$dict" "$tempdict"
    fi

    if [[ -n "${o_and:-}" ]]; then
        vecho "Checking words with both ${o_prefix} AND ${o_suffix}"
        grep -Eix "^${o_prefix}[${o_rack}]*${o_suffix}$" "$tempdict" \
            | awk -v min="${o_minlen:-1}" -v max="${o_maxlen:-15}" \
                'length($0) >= min && length($0) <= max { print tolower($0) }' \
            > "$tmp2"
        filterWords and
    else
        if [[ -n "${o_prefix:-}" ]]; then
            vecho "Checking prefixed words '${o_prefix}'"
            grep -Eix "^${o_prefix}[${o_rack}]*$" "$tempdict" \
                | awk -v min="${o_minlen:-1}" -v max="${o_maxlen:-15}" \
                    'length($0) >= min && length($0) <= max { print tolower($0) }' \
                > "$tmp2"
            filterWords prefix
        fi

        if [[ -n "${o_suffix:-}" ]]; then
            vecho "Checking suffixed words '${o_suffix}'"
            grep -Eix "^[${o_rack}]*${o_suffix}$" "$tempdict" \
                | awk -v min="${o_minlen:-1}" -v max="${o_maxlen:-15}" \
                    'length($0) >= min && length($0) <= max { print tolower($0) }' \
                > "$tmp2"
            filterWords suffix
        fi

        if [[ -z "${o_prefix:-}${o_suffix:-}" ]]; then
            vecho "Checking regular words"
            grep -Eix "^[${o_rack}]*$" "$tempdict" \
                | awk -v min="${o_minlen:-1}" -v max="${o_maxlen:-15}" \
                    'length($0) >= min && length($0) <= max { print tolower($0) }' \
                > "$tmp2"
            filterWords normal
        fi
    fi

    sort -u "$tmp1" > "$tmp2"
    mv "$tmp2" "$tmp1"

    if [[ -n "${o_req:-}" ]]; then
        vecho "Checking required characters | ${o_req} |"
        require_letters "$tmp1" "$tmp2" "$o_req"
        mv "$tmp2" "$tmp1"
    fi

    if [[ -n "${o_pat:-}" ]]; then
        grep -Eix "^${o_pat}$" "$tmp1" > "$tmp2"
        mv "$tmp2" "$tmp1"
    fi

    vecho "Filtering pure prefixes and suffixes"
    awk \
        -v p="${o_prefix:-}" \
        -v s="${o_suffix:-}" \
        -v u="${o_use:-}" \
        -v pat="${o_pat:-}" '
        BEGIN {
            pure = pat
            gsub(/[^[:alpha:]]/, "", pure)
        }
        $0 != p && $0 != s && !(u != "" && $0 == pure) { print }
    ' "$tmp1" > "$tmp2"
    mv "$tmp2" "$tmp1"
}

allDicts() {
    for dict in "${dicts[@]}"; do
        oneDict
        cat "$tmp1" >> "$combined"
    done
}

processRack() {
    if [[ -n "${o_double:-}" ]]; then
        local origrack=$o_rack dcmd wcmd cmd frag
        IFS=';' read -r -a dcmds <<< "$o_double"

        for dcmd in "${dcmds[@]}"; do
            [[ -z "$dcmd" ]] && continue
            wcmd=${dcmd//|/ }
            cmd=${wcmd%% *}
            for frag in ${wcmd#* }; do
                o_rack=$origrack
                case "$cmd" in
                    use)
                        o_pat=".*${frag}.*"
                        o_rack="${origrack}${frag//[^a-z]/}"
                        o_use=true
                        ;;
                    pre) o_prefix=$frag ;;
                    suf) o_suffix=$frag ;;
                    sides) echo "side-suffix is not implemented" >&2; exit 2 ;;
                    sidep) echo "side-prefix is not implemented" >&2; exit 2 ;;
                esac
                allDicts
            done
        done
    else
        allDicts
    fi
}

mainprog() {
    initFiles

    if [[ -n "${o_blank:-}" ]]; then
        local origrack=$o_rack L
        for L in {a..z}; do
            printf '%s ' "$L"
            o_rack="${origrack}${L}"
            processRack
        done
        echo
    else
        processRack
    fi

    showResults

    sort -u "$combined" > "$tmp1"
    mv "$tmp1" "${HOME}/.scrabresults"
    wordsfound=$(wc -l < "${HOME}/.scrabresults")
    export wordsfound
}

[[ -z "${1:-}" ]] && usage

if [[ "${1:0:1}" != "-" ]]; then
    o_rack=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    shift
else
    o_no_rack=true
fi

unset o_prefix o_suffix o_either o_and o_pat o_req o_verbose o_debug
unset o_len o_growl o_dict o_nosum o_double o_use o_remove o_blank
unset o_minlen o_maxlen

while getopts ":r:p:P:s:S:e:E:au:U:x:R:bm:M:4:q:Q:l:L:w:D:nvd" option; do
    lowerarg=$(printf '%s' "${OPTARG:-}" | tr '[:upper:]' '[:lower:]')

    case "$option" in
        r) o_rack=$lowerarg; unset o_no_rack ;;
        p) o_prefix=$lowerarg ;;
        P) o_pat="${lowerarg}.*" ;;
        s) o_suffix=$lowerarg ;;
        S) o_pat=".*${lowerarg}" ;;
        e) o_either=$lowerarg ;;
        E) o_pat="${lowerarg}.*|.*${lowerarg}" ;;
        a) o_and=true ;;
        u)
            o_pat=".*${lowerarg}.*"
            o_rack="${o_rack}${lowerarg//[^a-z]/}"
            o_use=true
            ;;
        U) o_pat=".*${lowerarg}.*"; o_use=true ;;
        x) o_rack="${o_rack}${lowerarg}" ;;
        R) o_remove=$lowerarg ;;
        b) o_blank=true ;;
        m)
            o_pat=$lowerarg
            o_rack="${o_rack}${lowerarg//[^a-z]/}"
            ;;
        M) o_pat=$lowerarg ;;
        4)
            [[ -n "${o_no_rack:-}" ]] && usage
            o_rack="${o_rack}${o_rack}${o_rack}${o_rack}"
            o_req=$lowerarg
            o_minlen=4
            ;;
        q)
            o_rack="${o_rack}${lowerarg}"
            o_req="${o_req:-}${lowerarg}"
            ;;
        Q) o_req="${o_req:-}${lowerarg}" ;;
        l) o_minlen=$OPTARG ;;
        L) o_maxlen=$OPTARG ;;
        w) o_minlen=$OPTARG; o_maxlen=$OPTARG ;;
        D) o_dict="${o_dict:+${o_dict}|}${OPTARG}" ;;
        n) o_nosum=true ;;
        v) o_verbose=true ;;
        d) o_debug=true ;;
        :)
            echo "Required argument to -${OPTARG} not specified." >&2
            exit 1
            ;;
        \?)
            case "${OPTARG}" in
                -)
                    # Long options are handled below after getopts terminates.
                    ;;
                *)
                    echo "Unexpected option -${OPTARG}; --help for help." >&2
                    exit 1
                    ;;
            esac
            ;;
    esac
done

shift $((OPTIND - 1))

# Handle long options, preserving the original multi-value interface.
while (($#)); do
    case "$1" in
        --version) usage version ;;
        --help) usage help ;;
        --examples) usage examples ;;
        --use|--pre|--suf|--prefixes|--suffixes)
            case "$1" in
                --use) cmd=use ;;
                --pre|--prefixes) cmd=pre ;;
                --suf|--suffixes) cmd=suf ;;
            esac
            shift
            group=$cmd
            while (($#)) && [[ "$1" != -* ]]; do
                group+="|$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
                shift
            done
            o_double="${o_double:+${o_double};}${group}"
            ;;
        --side-suffix)
            echo "side-suffix is not implemented" >&2
            exit 2
            ;;
        --side-prefix)
            echo "side-prefix is not implemented" >&2
            exit 2
            ;;
        *)
            echo "Unexpected argument \"$1\"; --help for help." >&2
            exit 1
            ;;
    esac
done

checkOpts

if [[ -z "${o_nosum:-}" ]]; then
    exec 3>&1 4>&2
    elapsed=$(TIMEFORMAT="%R"; { time mainprog 1>&3 2>&4; } 2>&1)
    exec 3>&- 4>&-
    wf=$(wc -l < "${HOME}/.scrabresults")
    echo "${wf} words, ${elapsed} secs from ${args}"
else
    mainprog
fi
